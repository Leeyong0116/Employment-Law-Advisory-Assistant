# Copy to .env and fill in. .env is gitignored — never commit real keys.
# Generation (config/config.yaml, generation:). For vLLM on the HPC, the OOD
# app URL ending in /v1, and the Cookie header copied from a logged-in browser
# session (it expires; copy a fresh one when a run reports the session expired).
GENERATOR_BASE_URL=
OOD_COOKIE_SECRET=

# For a hosted API instead, set one of these and point generation.api_key_env at it.

# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=

# PostgreSQL password for the local index database (docker-compose.yml).
# Any random string; only used on this machine.
POSTGRES_PASSWORD=
