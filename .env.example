# Copy to .env and fill in. .env is gitignored: never commit real keys.

# Generation (config/config.yaml, generation:). For vLLM on the HPC, the OOD
# app URL ending in /v1, and the Cookie header copied from a logged-in browser
# session (it expires; copy a fresh one when a run reports the session expired).
GENERATOR_BASE_URL=
OOD_COOKIE_SECRET=

# For a hosted API instead, set one of these and point generation.api_key_env at it.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=

# PostgreSQL password for the local index database (docker-compose.yml).
# Any random string; only used on this machine.
POSTGRES_PASSWORD=

# Docker Compose prefixes volume names with the project name, which defaults
# to the folder name. Pinning it keeps the same volumes (the index in
# <name>_getright-pgdata, model weights in <name>_getright-hf-cache) when the
# repository is cloned into a folder with a different name. Without it,
# Compose creates new empty volumes and the index must be rebuilt.
COMPOSE_PROJECT_NAME=fyp-employment-law-chatbot
