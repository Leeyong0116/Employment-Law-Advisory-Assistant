# Copy to .env and fill in. .env is gitignored: never commit real keys.

# Generation (config/config.yaml, generation:). Current generator: the DeepSeek
# hosted API (since 2026-11-06). Base URL ending in /v1, and your API key.
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=

# Only for switching back to vLLM on the HPC (see the comment in config.yaml):
# the OOD app URL ending in /v1, and the Cookie header copied from a logged-in
# browser session (it expires; copy a fresh one when a run reports the session expired).
GENERATOR_BASE_URL=
OOD_COOKIE_SECRET=

# PostgreSQL password for the local index database (docker-compose.yml).
# Any random string; only used on this machine.
POSTGRES_PASSWORD=

# Docker Compose prefixes volume names with the project name, which defaults
# to the folder name. Pinning it keeps the same volumes (the index in
# <name>_getright-pgdata, model weights in <name>_getright-hf-cache) when the
# repository is cloned into a folder with a different name. Without it,
# Compose creates new empty volumes and the index must be rebuilt.
COMPOSE_PROJECT_NAME=fyp-employment-law-chatbot
